{
  "name": "agora",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "eval:phase6:deterministic": "vitest run --config vitest.eval.config.ts -t 'phase6 deterministic baseline'",
    "eval:phase6:model": "vitest run --config vitest.eval.config.ts -t 'phase6 model baseline'",
    "eval:phase7:deterministic": "vitest run --config vitest.eval.config.ts -t 'phase7 deterministic baseline'",
    "eval:phase7:model": "vitest run --config vitest.eval.config.ts -t 'phase7 model baseline'",
    "eval:phase8:deterministic": "vitest run --config vitest.eval.config.ts -t 'phase8 deterministic baseline'",
    "eval:phase8:model": "vitest run --config vitest.eval.config.ts -t 'phase8 model baseline'",
    "build:sandbox-native": "node packages/runtime/sandbox/scripts/build-native.mjs",
    "eval:phase9:deterministic": "pnpm build:sandbox-native && vitest run --config vitest.eval.config.ts -t 'phase9 deterministic baseline'",
    "eval:phase9:model": "pnpm build:sandbox-native && vitest run --config vitest.eval.config.ts -t 'phase9 model baseline'",
    "eval:phase9:verify-model": "pnpm build:sandbox-native && vitest run --config vitest.eval.config.ts -t 'phase9 model repair verification'",
    "eval:phase9:format-repair": "pnpm build:sandbox-native && vitest run --config vitest.eval.config.ts -t 'phase9 format repair G5'",
    "setup": "node apps/web/scripts/local.mjs setup",
    "doctor": "node apps/web/scripts/local.mjs doctor",
    "start": "node apps/web/scripts/local.mjs start",
    "stop": "node apps/web/scripts/local.mjs stop",
    "credentials:adopt": "node apps/web/scripts/local.mjs adopt-key",
    "build:keychain-native": "node packages/runtime/state/scripts/build-keychain.mjs"
  },
  "devDependencies": {
    "@agora/core-domain": "workspace:*",
    "@agora/core-orchestration": "workspace:*",
    "@agora/comm-bus": "workspace:*",
    "@agora/comm-channels": "workspace:*",
    "@agora/roles-definitions": "workspace:*",
    "@agora/runtime-executor": "workspace:*",
    "@agora/runtime-sandbox": "workspace:*",
    "@agora/runtime-state": "workspace:*",
    "@agora/tools-bridge": "workspace:*",
    "@agora/tools-fs": "workspace:*",
    "@agora/tools-git": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.1-rc.2"
  }
}
