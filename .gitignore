.DS_Store
.AppleDouble
.LSOverride
._*

# ==========================
#  Node.js / TypeScript
# ==========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
*.tsbuildinfo

# ==========================
#  环境变量（密钥绝对不能上传！）
# ==========================
.env
.env.local
.env.*.local
*.pem

# ==========================
#  编辑器 / IDE
# ==========================
.vscode/
.idea/
*.swp
*.swo
*~
.bsb*

# ==========================
#  操作系统临时文件
# ==========================
Thumbs.db
Desktop.ini

# ==========================
#  项目特定：阶段 0 本地临时沙箱目录（千万别传这些测试垃圾）
# ==========================
/tmp-agora-*
/test-outputs/
/.agora-sandbox/
/.data/

# ==========================
#  本地工具状态（机器特定，不要上传）
