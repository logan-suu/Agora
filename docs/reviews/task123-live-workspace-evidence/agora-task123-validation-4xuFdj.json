  "generatedSource": "'use strict';\n\nclass LRUCache {\n  constructor(capacity, ttlMs = Infinity) {\n    if (!Number.isInteger(capacity) || capacity <= 0) {\n      throw new RangeError('capacity must be a positive integer');\n    }\n    this.capacity = capacity;\n    this.ttlMs = ttlMs;\n    this._entries = new Map();\n  }\n\n  get(key) {\n    const entry = this._entries.get(key);\n    if (entry === undefined) {\n      return undefined;\n    }\n    if (this._isExpired(entry)) {\n      this._entries.delete(key);\n      return undefined;\n    }\n    // Refresh recency by re-inserting at the end of the Map's order.\n    this._entries.delete(key);\n    this._entries.set(key, entry);\n    return entry.value;\n  }\n\n  set(key, value) {\n    if (this._entries.has(key)) {\n      this._entries.delete(key);\n    }\n    const expiresAt = this.ttlMs === Infinity ? Infinity : Date.now() + this.ttlMs;\n    this._entries.set(key, { value, expiresAt });\n    while (this._entries.size > this.capacity) {\n      const oldestKey = this._entries.keys().next().value;\n      this._entries.delete(oldestKey);\n    }\n    return this;\n  }\n\n  delete(key) {\n    const existed = this._entries.has(key);\n    this._entries.delete(key);\n    return existed;\n  }\n\n  _isExpired(entry) {\n    return this.ttlMs !== Infinity && entry.expiresAt <= Date.now();\n  }\n}\n\nmodule.exports = { LRUCache };\n",
